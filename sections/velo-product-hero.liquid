{{ 'velo-product-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'velo-product-hero.js' | asset_url }}" defer="defer"></script>

<!-- Lightbox Overlay -->
<div class="velo-lightbox" id="veloLightbox" role="dialog" aria-modal="true" aria-label="Image Preview">
  <div class="velo-lightbox-backdrop"></div>
  <div class="velo-lightbox-inner">
    <button class="velo-lightbox-close" aria-label="Chiudi"></button>
    <button class="velo-lightbox-arrow velo-lightbox-prev" aria-label="Previous">&#8249;</button>
    <img class="velo-lightbox-img" src="" alt="" id="veloLightboxImg">
    <button class="velo-lightbox-arrow velo-lightbox-next" aria-label="Next">&#8250;</button>
  </div>
</div>

{%- assign current_product = section.settings.product | default: product -%}

{%- style -%}
  #veloBuyBox-{{ section.id }} .velo-atc-btn {
    background-color: {{ section.settings.cta_bg_color | default: '#FF6B00' }} !important;
    color: {{ section.settings.cta_text_color | default: '#ffffff' }} !important;
  }
  #veloBuyBox-{{ section.id }} .velo-atc-btn:hover {
     filter: brightness(0.9);
  }
{%- endstyle -%}

{%- assign gallery_images = current_product.media -%}

<div class="velo-hero-wrapper">
  <div class="velo-hero-container page-width velo-mobile-image-{{ section.settings.mobile_image_position | default: 'top' }}">
    <!-- Left Column: Media Gallery (hidden on mobile, shown after buy-box via order) -->
    <div class="velo-media-gallery" id="veloMediaGallery-{{ section.id }}">
      {% if current_product != blank and gallery_images.size > 0 %}
        <div class="velo-media-main-wrapper">
          {%- for media in gallery_images -%}
            <div class="velo-media-main-item" data-media-id="{{ media.id }}" {% if forloop.first %}style="display: block;"{% else %}style="display: none;"{% endif %}>
              {% case media.media_type %}
                {% when 'image' %}
                  <a href="{{ media | image_url: width: 1800 }}"
                     class="velo-lightbox-trigger"
                     data-src="{{ media | image_url: width: 1800 }}"
                     data-alt="{{ media.alt | escape }}"
                     aria-label="Visualizza immagine ingrandita">
                    <img
                      src="{{ media | image_url: width: 800 }}"
                      alt="{{ media.alt | escape }}"
                      loading="eager"
                      width="{{ media.width }}"
                      height="{{ media.height }}"
                      srcset="
                        {{ media | image_url: width: 600 }} 600w,
                        {{ media | image_url: width: 800 }} 800w,
                        {{ media | image_url: width: 1200 }} 1200w
                      "
                      sizes="(min-width: 990px) 50vw, 100vw"
                    >
                    <span class="velo-zoom-icon" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                    </span>
                  </a>
                {% when 'video' %}
                  <div class="velo-video-wrapper">
                    {{ media | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
                  </div>
                {% when 'external_video' %}
                  <div class="velo-video-wrapper">
                    {{ media | external_video_url: autoplay: true, loop: true, mute: true, playlist: media.external_id | external_video_tag }}
                  </div>
              {% endcase %}
            </div>
          {%- endfor -%}
        </div>

        <div class="velo-media-thumbnails-wrapper">
          <button type="button" class="velo-thumbnails-nav velo-thumbnails-prev" aria-label="Previous thumbnails">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <div class="velo-media-thumbnails">
            {% for media in gallery_images %}
              <div class="velo-thumbnail-item {% if forloop.first %}velo-thumbnail--active{% endif %}" data-media-id="{{ media.id }}">
                <img src="{{ media.preview_image | image_url: width: 100 }}" alt="{{ media.alt | escape }}" loading="lazy" width="100" height="100">
              </div>
            {% endfor %}
          </div>
          <button type="button" class="velo-thumbnails-nav velo-thumbnails-next" aria-label="Next thumbnails">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      {% else %}
        <div class="velo-media-placeholder" style="aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:#f5f5f5;border-radius:8px;">
          <p style="color:#999;font-size:1.4rem;">Seleziona un prodotto nelle impostazioni della sezione.</p>
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Sticky Buy Box -->
    <div class="velo-buy-box" id="veloBuyBox-{{ section.id }}">
      <div class="velo-buy-box-inner">
        <!-- Badges -->
        <div class="velo-badges">
          {% if section.settings.badge_1 != blank %}
            <span class="velo-badge velo-badge--primary">{{ section.settings.badge_1 }}</span>
          {% endif %}
          {% if section.settings.badge_2 != blank %}
            <span class="velo-badge velo-badge--secondary">{{ section.settings.badge_2 }}</span>
          {% endif %}
        </div>

        <!-- Review Stars -->
        {% if section.settings.show_reviews %}
          {%- assign rating_num = section.settings.rating_value | times: 1.0 -%}
          <div class="velo-rating">
            <div class="velo-stars">
              {% for i in (1..5) %}
                {%- assign i_minus_1 = i | minus: 1 -%}
                {%- assign star_fill = 0 -%}
                {%- if rating_num >= i -%}
                  {%- assign star_fill = 100 -%}
                {%- elsif rating_num > i_minus_1 -%}
                  {%- assign star_fill = rating_num | minus: i_minus_1 | times: 100 -%}
                {%- endif -%}
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                  <defs>
                    <linearGradient id="star-grad-{{ i }}-{{ section.id }}">
                      <stop offset="{{ star_fill }}%" stop-color="#DDA75B" />
                      <stop offset="{{ star_fill }}%" stop-color="#E0E0E0" />
                    </linearGradient>
                  </defs>
                  <path fill="url(#star-grad-{{ i }}-{{ section.id }})" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            <span class="velo-rating-text">{{ section.settings.rating_value }} | {{ section.settings.review_count }} recensioni</span>
          </div>
        {% endif %}

        <!-- Product Title -->
        <h1 class="velo-product-title">{{ current_product.title }}</h1>

        <!-- Pricing -->
        {% if current_product.selected_or_first_available_variant.compare_at_price > current_product.selected_or_first_available_variant.price %}
          <div class="velo-pricing">
            <span class="velo-price-compare">{{ current_product.selected_or_first_available_variant.compare_at_price | money }}</span>
            <span class="velo-price-current" id="veloPrice-{{ section.id }}">{{ current_product.selected_or_first_available_variant.price | money }}</span>
            {%- assign save_pct = current_product.selected_or_first_available_variant.compare_at_price | minus: current_product.selected_or_first_available_variant.price | times: 100 | divided_by: current_product.selected_or_first_available_variant.compare_at_price -%}
            <span class="velo-save-badge">{{ section.settings.save_text | default: 'SALVA' }} {{ save_pct }}%</span>
          </div>
        {% else %}
          <div class="velo-pricing">
            <span class="velo-price-current" id="veloPrice-{{ section.id }}">{{ current_product.selected_or_first_available_variant.price | money }}</span>
          </div>
        {% endif %}

        <!-- Trust Note -->
        {% if section.settings.trust_note != blank %}
          <div class="velo-trust-note">
            {% render 'velo-icons', icon: 'lock' %}
            {{ section.settings.trust_note | replace: '[shop_name]', shop.name }}
          </div>
        {% endif %}

        <!-- Product Description / Bullets -->
        <div class="velo-description-text">
          {{ section.settings.hero_desc | default: "The only topper that supports your body's natural need for absolute comfort - working with your body, not against it." }}
        </div>
        
        {% if section.settings.bullet_1 != blank or section.settings.bullet_2 != blank or section.settings.bullet_3 != blank or section.settings.bullet_4 != blank %}
          <ul class="velo-bullets velo-bullets--font-{{ section.settings.bullet_font_size | default: 'default' }}">
            {% for i in (1..4) %}
              {% capture bullet_key %}bullet_{{ i }}{% endcapture %}
              {% assign bullet_text = section.settings[bullet_key] %}
              {% if bullet_text != blank %}
                <li>
                  <div class="velo-bullet-check">{% render 'velo-icons', icon: 'check' %}</div>
                  <div class="velo-bullet-text">{{ bullet_text }}</div>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if current_product != blank %}
          {%- form 'product', current_product -%}
            {%- unless current_product.has_only_default_variant -%}
              <div class="velo-variants">
                {% for option in current_product.options_with_values %}
                  <div class="velo-option-group">
                    <label class="velo-option-label">{{ option.name }}: <span id="veloOptionLabel-{{ section.id }}-{{ forloop.index0 }}">{{ option.selected_value }}</span></label>
                    <div class="velo-option-values">
                      {% assign opt_idx = forloop.index0 %}
                      {% assign color_swatches = section.blocks | where: 'type', 'swatch_color' %}
                      {% for value in option.values %}
                        {%- assign custom_color = blank -%}
                        {%- for swatch in color_swatches -%}
                          {%- assign swatch_title_handle = swatch.settings.title | handle -%}
                          {%- assign value_handle = value | handle -%}
                          {%- if swatch_title_handle == value_handle -%}
                            {%- assign custom_color = swatch.settings.color -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}

                        {%- assign swatch_image = blank -%}
                        {%- if custom_color == blank -%}
                          {%- for variant in current_product.variants -%}
                            {%- if variant.options[opt_idx] == value and variant.image -%}
                              {%- assign swatch_image = variant.image -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}

                        <label class="velo-swatch {% if option.selected_value == value %}velo-swatch--active{% endif %}" data-color="{{ value | escape }}" title="{{ value | escape }}">
                          <input type="radio" name="option-{{ option.name | handleize }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-index="{{ opt_idx }}" class="velo-swatch-input">
                          <span class="velo-swatch-inner" style="{% if custom_color != blank %}background-color: {{ custom_color }};{% elsif swatch_image %}background-image: url('{{ swatch_image | image_url: width: 100 }}'); background-size: cover; background-position: center;{% else %}background-color: {{ value | handle }};{% endif %}"></span>
                        </label>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {%- endunless -%}
            <input type="hidden" name="id" id="veloVariantId-{{ section.id }}" value="{{ current_product.selected_or_first_available_variant.id }}">
            <script type="application/json" id="veloVariantJson-{{ section.id }}">{{ current_product.variants | json }}</script>
            <script>
              window.veloSettings = window.veloSettings || {};
              window.veloSettings['{{ section.id }}'] = {
                moneyFormat: {{ shop.money_format | json }},
                saveText: {{ section.settings.save_text | default: 'SALVA' | json }}
              };
            </script>

            <div class="velo-hero-buy-elements">
              {%- assign gift_blocks = section.blocks | where: 'type', 'gift' -%}
              {% if gift_blocks.size > 0 %}
                <div class="velo-hero-gifts-grid velo-hero-gifts-grid--mobile-{{ section.settings.mobile_gifts_layout | default: '2' }}">
                  {% for block in gift_blocks %}
                    <div class="velo-hero-gift-card" {{ block.shopify_attributes }}>
                      <div class="velo-hero-gift-badge">{{ block.settings.value }} {{ block.settings.free_text | default: 'FREE' }}</div>
                      <div class="velo-hero-gift-image-box">
                        {% if block.settings.image != blank %}
                          <img src="{{ block.settings.image | image_url: width: 150 }}" alt="{{ block.settings.title }}" width="150" loading="lazy">
                        {% else %}
                          {% render 'velo-icons', icon: block.settings.icon %}
                        {% endif %}
                      </div>
                      <div class="velo-hero-gift-title">{{ block.settings.free_text | default: section.settings.free_label | default: 'GRATIS' }} {{ block.settings.title }}</div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
              {% if section.settings.urgency_text != blank %}
                {%- assign today_day = 'now' | date: "%d" -%}
                {%- assign today_month_num = 'now' | date: "%m" -%}
                {%- case today_month_num -%}
                  {%- when '01' -%}{%- assign today_month_name = 'Gennaio' -%}
                  {%- when '02' -%}{%- assign today_month_name = 'Febbraio' -%}
                  {%- when '03' -%}{%- assign today_month_name = 'Marzo' -%}
                  {%- when '04' -%}{%- assign today_month_name = 'Aprile' -%}
                  {%- when '05' -%}{%- assign today_month_name = 'Maggio' -%}
                  {%- when '06' -%}{%- assign today_month_name = 'Giugno' -%}
                  {%- when '07' -%}{%- assign today_month_name = 'Luglio' -%}
                  {%- when '08' -%}{%- assign today_month_name = 'Agosto' -%}
                  {%- when '09' -%}{%- assign today_month_name = 'Settembre' -%}
                  {%- when '10' -%}{%- assign today_month_name = 'Ottobre' -%}
                  {%- when '11' -%}{%- assign today_month_name = 'Novembre' -%}
                  {%- when '12' -%}{%- assign today_month_name = 'Dicembre' -%}
                {%- endcase -%}
                {%- assign today_date_str = today_day | append: ' ' | append: today_month_name -%}
                <div class="velo-urgency-pill">
                  <span class="velo-urgency-dot"></span>
                  <span>{{ section.settings.urgency_text | replace: '[date]', today_date_str }}</span>
                </div>
              {% endif %}
              <div class="velo-atc-wrapper">
                <button type="submit" class="velo-atc-btn">
                  {% if current_product.available %}{{ section.settings.atc_text | default: 'ACQUISTA ORA' }}{% else %}{{ section.settings.sold_out_text | default: 'ESAURITO' }}{% endif %}
                </button>
              </div>
              <div class="velo-hero-trust-strip">
                <div class="velo-hero-trust-item">{% render 'velo-icons', icon: 'truck' %}<span>{{ section.settings.trust_1 }}</span></div>
                <div class="velo-hero-trust-item">{% render 'velo-icons', icon: 'refresh' %}<span>{{ section.settings.trust_2 }}</span></div>
              </div>
            </div>
          {%- endform -%}

        {% else %}
          <div class="velo-hero-buy-elements">
            {%- assign gift_blocks = section.blocks | where: 'type', 'gift' -%}
            {% if gift_blocks.size > 0 %}
              <div class="velo-hero-gifts-grid velo-hero-gifts-grid--mobile-{{ section.settings.mobile_gifts_layout | default: '2' }}">
                {% for block in gift_blocks %}
                  <div class="velo-hero-gift-card" {{ block.shopify_attributes }}>
                    <div class="velo-hero-gift-image">{% render 'velo-icons', icon: block.settings.icon %}</div>
                    <div class="velo-hero-gift-title"><strong>FREE</strong> {{ block.settings.title }}</div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
            {% if section.settings.urgency_text != blank %}
              {%- assign today_day = 'now' | date: "%d" -%}
              {%- assign today_month_num = 'now' | date: "%m" -%}
              {%- case today_month_num -%}
                {%- when '01' -%}{%- assign today_month_name = 'Gennaio' -%}
                {%- when '02' -%}{%- assign today_month_name = 'Febbraio' -%}
                {%- when '03' -%}{%- assign today_month_name = 'Marzo' -%}
                {%- when '04' -%}{%- assign today_month_name = 'Aprile' -%}
                {%- when '05' -%}{%- assign today_month_name = 'Maggio' -%}
                {%- when '06' -%}{%- assign today_month_name = 'Giugno' -%}
                {%- when '07' -%}{%- assign today_month_name = 'Luglio' -%}
                {%- when '08' -%}{%- assign today_month_name = 'Agosto' -%}
                {%- when '09' -%}{%- assign today_month_name = 'Settembre' -%}
                {%- when '10' -%}{%- assign today_month_name = 'Ottobre' -%}
                {%- when '11' -%}{%- assign today_month_name = 'Novembre' -%}
                {%- when '12' -%}{%- assign today_month_name = 'Dicembre' -%}
              {%- endcase -%}
              {%- assign today_date_str = today_day | append: ' ' | append: today_month_name -%}
              <div class="velo-urgency-pill">
                <span class="velo-urgency-dot"></span>
                <span>{{ section.settings.urgency_text | replace: '[date]', today_date_str }}</span>
              </div>
            {% endif %}
            <div class="velo-atc-wrapper">
              <a href="{{ section.settings.product_url | default: '/products' }}" class="velo-atc-btn" style="display:block;text-align:center;text-decoration:none;">
                {{ section.settings.atc_text | default: 'ADD TO CART +' }}
              </a>
            </div>
            <div class="velo-hero-trust-strip">
              <div class="velo-hero-trust-item">{% render 'velo-icons', icon: 'truck' %}<span>{{ section.settings.trust_1 }}</span></div>
              <div class="velo-hero-trust-item">{% render 'velo-icons', icon: 'refresh' %}<span>{{ section.settings.trust_2 }}</span></div>
            </div>
          </div>
        {% endif %}
      </div>

      {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
      {% if accordion_blocks.size > 0 %}
        <div class="velo-hero-accordions">
          {% for block in accordion_blocks %}
            <details class="velo-hero-accordion" {{ block.shopify_attributes }}>
              <summary class="velo-hero-accordion-trigger">
                <span>{{ block.settings.title }}</span>
                <div class="velo-accordion-icon">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 8h12M8 2v12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
              </summary>
              <div class="velo-hero-accordion-content">{{ block.settings.content }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}

      </div>
    </div>
  </div>
</div>



{% schema %}
{
  "name": "VELO Product Hero",
  "tag": "section",
  "class": "velo-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile Image Position",
      "options": [
        {
          "value": "top",
          "label": "Top (Before Info)"
        },
        {
          "value": "bottom",
          "label": "Bottom (After Info)"
        }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge 1",
      "default": "BESTSELLER"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Badge 2",
      "default": "#1 ACTIVE SITTING CHAIR"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review stars",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating (text, e.g. 4.9)",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "140"
    },
    {
      "type": "header",
      "content": "Copy & Selling Points"
    },
    {
      "type": "select",
      "id": "mobile_gifts_layout",
      "label": "Mobile Gifts Layout",
      "options": [
        {
          "value": "1",
          "label": "1 Row (4 items)"
        },
        {
          "value": "2",
          "label": "2 Rows (2 items per row)"
        }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "trust_note",
      "label": "Trust Note (Lock)",
      "default": "Only available at [shop_name]"
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Product Description Snippet",
      "default": "The only topper that supports your body's natural need for absolute comfort - working with your body, not against it."
    },
    {
      "type": "inline_richtext",
      "id": "bullet_1",
      "label": "Bullet Point 1",
      "default": "Energy: Prevents all-day sitting fatigue"
    },
    {
      "type": "inline_richtext",
      "id": "bullet_2",
      "label": "Bullet Point 2",
      "default": "Focus: Boosts concentration and clarity"
    },
    {
      "type": "inline_richtext",
      "id": "bullet_3",
      "label": "Bullet Point 3",
      "default": "Productivity: Increases daily work output"
    },
    {
      "type": "inline_richtext",
      "id": "bullet_4",
      "label": "Bullet Point 4"
    },
    {
      "type": "select",
      "id": "bullet_font_size",
      "label": "Bullet Font Size",
      "options": [
        {
          "value": "small",
          "label": "Slightly Smaller"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "large",
          "label": "Slightly Larger"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Gifts"
    },
    {
      "type": "text",
      "id": "gifts_heading",
      "label": "Gifts Section Heading",
      "default": "Limited Sale! Unlock FREE Gifts With Your Order"
    },
    {
      "type": "header",
      "content": "Urgency"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Banner Text",
      "default": "Order by February 21st for guaranteed FREE Gifts"
    },
    {
      "type": "header",
      "content": "Add to Cart & Colors"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA Button Background",
      "default": "#FF6B00"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Button Text",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "atc_text",
      "label": "Add to Cart Button Text",
      "default": "ACQUISTA ORA"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold Out Text",
      "default": "ESAURITO"
    },
    {
      "type": "text",
      "id": "save_text",
      "label": "Save Badge Text",
      "default": "SALVA"
